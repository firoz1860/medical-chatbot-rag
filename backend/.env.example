# Required production secrets. Leave blank locally until you create a private .env file.
OPENAI_API_KEY=
PINECONE_API_KEY=

# Existing RAG defaults
OPENAI_MODEL=gpt-4o
PINECONE_ENV=us-east-1
PINECONE_INDEX=medical-chatbot
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K_RESULTS=5

# HTTP and upload safety
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_BYTES=52428800
MAX_QUESTION_LENGTH=2000
MAX_HISTORY_CONTENT_LENGTH=4000
